<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- rclone habla con el remoto. El volumen es almacenamiento privado de
         la app: no hace falta ningún permiso de ficheros. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Desde Android 17 (API 37), llegar a una dirección de la red local
         (un NAS en 192.168.x.x, el PC en 10.x) pide este permiso, y sin él la
         conexión se queda colgada hasta el timeout. Es de los que se piden al
         usarlo: se pide al conectar y al sincronizar. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Las notificaciones del llavero (llavero/Avisos.kt): una copia de
         conflicto nueva y un guardado que llegó cortado. Desde Android 13 se
         pide al usarlo: al activar el llavero. Sin él, lo dice la fila de la
         principal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La app se pone al día sola desde las releases de GitHub (Actualizador.kt).
         ACCESS_NETWORK_STATE: para no bajar el APK (unos 50 MB) con datos
         móviles. REQUEST_INSTALL_PACKAGES: para dárselo a instalar a Android;
         es el «instalar apps desconocidas» que la persona permite una vez.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION: con él, desde Android 12, Android
         no pregunta cada vez que la app se pone al día a sí misma. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- «Abrir llavero» (ui/PantallaLlavero.kt): si ninguna app de KeePass
         declara application/x-kdbx, la reserva es el genérico, por un selector.
         Para saber antes si hay alguna que lo abra (y si no, decirlo), Android
         11+ pide declarar la consulta. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/octet-stream" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraccion_de_datos"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Tema">
        <!-- Que Play services baje el escáner de QR al instalar la app, y no la
             primera vez que se pulsa «Escanear». -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lo que contesta Android al instalar la versión nueva. Solo le
             habla Android, por el PendingIntent explícito de la sesión. -->
        <receiver
            android:name=".ResultadoDeInstalacion"
            android:exported="false" />

        <!-- El volumen en la app de Archivos y en los diálogos de abrir y
             guardar de otras apps. MANAGE_DOCUMENTS lo tiene solo el sistema:
             nadie más puede hablar con el proveedor directamente. -->
        <provider
            android:name=".documentos.VolumenProvider"
            android:authorities="prdrive.app.documentos"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
